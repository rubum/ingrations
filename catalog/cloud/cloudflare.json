{
  "id": "cloudflare",
  "name": "Cloudflare",
  "description": "DNS records, cache purge, Worker deployment, and firewall rules.",
  "category": "cloud",
  "base_url": "https://api.cloudflare.com/client/v4",
  "icon": "shield",
  "docs_url": "https://developers.cloudflare.com/api/",
  "version": "1.0.0",
  "auth": {
    "auth_type": "bearer_token",
    "header_name": "Authorization",
    "token_prefix": "Bearer ",
    "env_vars": ["CLOUDFLARE_API_TOKEN", "CF_API_TOKEN"]
  },
  "actions": [
    {
      "id": "cloudflare.list_zones",
      "name": "List Zones",
      "description": "Lists and filters domain zones managed in the account.",
      "app_id": "cloudflare",
      "method": "GET",
      "path": "/zones",
      "tags": ["dns", "read"],
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "A domain name (e.g. example.com)",
          "required": false,
          "location": "query"
        }
      ]
    },
    {
      "id": "cloudflare.list_dns_records",
      "name": "List DNS Records",
      "description": "Lists DNS records for a given zone.",
      "app_id": "cloudflare",
      "method": "GET",
      "path": "/zones/{zone_id}/dns_records",
      "tags": ["dns", "read"],
      "parameters": [
        {
          "name": "zone_id",
          "type": "string",
          "description": "Zone identifier",
          "required": true,
          "location": "path"
        },
        {
          "name": "type",
          "type": "string",
          "description": "Record type: A, AAAA, CNAME, TXT, MX",
          "required": false,
          "location": "query"
        }
      ]
    },
    {
      "id": "cloudflare.create_dns_record",
      "name": "Create DNS Record",
      "description": "Creates a new DNS record in a zone.",
      "app_id": "cloudflare",
      "method": "POST",
      "path": "/zones/{zone_id}/dns_records",
      "tags": ["dns", "write"],
      "parameters": [
        {
          "name": "zone_id",
          "type": "string",
          "description": "Zone identifier",
          "required": true,
          "location": "path"
        },
        {
          "name": "type",
          "type": "string",
          "description": "DNS record type (e.g. A, CNAME, TXT)",
          "required": true,
          "location": "body"
        },
        {
          "name": "name",
          "type": "string",
          "description": "DNS record name (e.g. sub.example.com)",
          "required": true,
          "location": "body"
        },
        {
          "name": "content",
          "type": "string",
          "description": "DNS record target IP or value",
          "required": true,
          "location": "body"
        },
        {
          "name": "proxied",
          "type": "boolean",
          "description": "Whether the record gets Cloudflare's origin protection",
          "required": false,
          "location": "body",
          "default": true
        }
      ]
    },
    {
      "id": "cloudflare.purge_cache",
      "name": "Purge Cache",
      "description": "Purges cached resources from Cloudflare edge caches.",
      "app_id": "cloudflare",
      "method": "POST",
      "path": "/zones/{zone_id}/purge_cache",
      "tags": ["cache", "write"],
      "parameters": [
        {
          "name": "zone_id",
          "type": "string",
          "description": "Zone identifier",
          "required": true,
          "location": "path"
        },
        {
          "name": "purge_everything",
          "type": "boolean",
          "description": "Whether to purge entire edge cache",
          "required": false,
          "location": "body",
          "default": true
        }
      ]
    }
  ]
}
